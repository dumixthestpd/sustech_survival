# Cache — personal per-user state
# Caches now live in the user's home dot-dir: ~/.sustech_survival/cache/
# (outside the repo — see sustech_survival._cache). The old cwd-relative
# __sustech_cache__/ entry is kept defensively for stray copies from older
# versions, plus the legacy package-local tmp/ during migration.
__sustech_cache__/
src/sustech_survival/tmp/
_ptmp/

# Cookies — personal auth tokens (never commit)
cookies/
src/cookies/
*cookie*.txt
*cookie*.txt.tmp
bilibili_cookie.txt
bilibili_cookies_netscape.txt

# Personal info / device-specific data
personal.md
.hermes/
.DS_Store

# Lock files — libraries don't ship lock files.
# Apps depending on this lib should generate their own.
uv.lock

# Legacy UI verification artifacts (dev-only)
docs/ui-verification/

