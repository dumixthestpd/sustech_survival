dist/
build/
*.egg-info/
*.egg
# ...except the Electron app icons under electron/build/ — package.json
# (build.icon / win.icon / nsis.*Icon) and main.js reference them, so they
# must be tracked for a fresh clone to build electron without regeneration.
!electron/build/
!electron/build/icon.png
!electron/build/icon.ico
!electron/build/icon-256.png
!electron/build/icon-1024.png

